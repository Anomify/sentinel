# Secrets for the Sentinel system service. deploy/install.sh installs this as /etc/sentinel/sentinel.env
# (owned by root, mode 0600) and writes a new random SENTINEL_TOKEN above these lines.
#
# systemd reads this file, not Sentinel, so a comment must be on a line of its own: anything after a value,
# even "   # a note", becomes part of the value. An empty value counts as unset.
# .env.example says what each key enables. Restart the service after editing: sudo systemctl restart sentinel

# AI-search visibility. Once a key is set, every scheduled run makes one paid request per question per engine.
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
SERPAPI_API_KEY=

# AI analysis. Claude is used instead of Gemini when this is set.
ANTHROPIC_API_KEY=

# Ads intelligence. GOOGLE_APPLICATION_CREDENTIALS is a path, and the file must be readable by si.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
META_ADS_TOKEN=

# Digest delivery. SMTP_HOST defaults to smtp.gmail.com when SMTP_USER is set.
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM=
DIGEST_TO=
