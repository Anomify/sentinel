# Everything is optional. With no keys at all, Modules 1–7 and 9 (stack, GTM, DNS, certificates,
# staging radar, hiring, partners/funding, positioning) still run on free public sources.

# ── AI search visibility (Module 10) ─────────────────────────────────────────
PERPLEXITY_API_KEY=
OPENAI_API_KEY=          # ChatGPT (Responses API + web_search)
GEMINI_API_KEY=          # Gemini with Google Search grounding
SERPAPI_API_KEY=         # Google AI Overviews

# ── Analysis: "so what" on every change, Vs. us on every finding, weekly brief, AI-answer accuracy
ANTHROPIC_API_KEY=

# ── Ads intelligence (Module 8) — official sources only ─────────────────────
GOOGLE_APPLICATION_CREDENTIALS=   # service account for the BigQuery Ads Transparency public dataset
GOOGLE_CLOUD_PROJECT=
META_ADS_TOKEN=                   # Meta Ad Library API token

# ── Digest delivery ──────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM=
DIGEST_TO=

# ── Hosting ──────────────────────────────────────────────────────────────────
DATABASE_URL=            # postgresql://user:pass@host:5432/sentinel  (blank = SQLite in ./data)
SENTINEL_TOKEN=          # admin token; required to open the dashboard when set
