# ── AI-search engines (enable any; each runs your 20 questions) ──────────────
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
# Claude: writes the "so what / do this" for every change + the weekly brief,
# and can also be enabled as an AI-search engine in config/questions.yaml
ANTHROPIC_API_KEY=

# ── Digest delivery (configure one or both) ──────────────────────────────────
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM=
DIGEST_TO=

# ── Hosting ──────────────────────────────────────────────────────────────────
# Set to require a bearer token for the dashboard/API when exposed publicly.
SENTINEL_TOKEN=
