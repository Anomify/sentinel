# Copy this file to .env (Sentinel loads it automatically) and fill in what you have.
# ONE KEY IS ENOUGH for the full analysis layer: GEMINI_API_KEY (or ANTHROPIC_API_KEY).
# Everything is optional. With no keys at all, Modules 1–7 and 9 (stack, GTM, DNS, certificates,
# staging radar, hiring, partners/funding, positioning) still run on free public sources.

# ── AI search visibility (Module 10) ─────────────────────────────────────────
PERPLEXITY_API_KEY=
OPENAI_API_KEY=          # ChatGPT (Responses API + web_search)
GEMINI_API_KEY=          # Gemini: AI analysis (so-what, Vs. us, brief, accuracy) + Gemini AI-search engine
SERPAPI_API_KEY=         # Google AI Overviews

# ── Analysis alternative: Claude is used instead of Gemini when this is set (config/settings.yaml → analysis.provider)
ANTHROPIC_API_KEY=

# ── Ads intelligence (Module 8) — official sources only ─────────────────────
GOOGLE_APPLICATION_CREDENTIALS=   # service account for the BigQuery Ads Transparency public dataset
GOOGLE_CLOUD_PROJECT=
META_ADS_TOKEN=                   # Meta Ad Library API token

# ── Digest delivery ──────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
# Google Workspace: SMTP_USER=you@hyperfence.io and SMTP_PASS=a 16-character app password
# (myaccount.google.com/apppasswords). SMTP_HOST defaults to smtp.gmail.com when blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM=
DIGEST_TO=               # blank = config/settings.yaml digest.to (keith@hyperfence.io)

# ── Social media (optional) ─────────────────────────────────────────────────
X_BEARER_TOKEN=          # X (Twitter) API v2; X's API is paid. Without it, X accounts get a check-by-hand link.

# ── Hosting ──────────────────────────────────────────────────────────────────
DATABASE_URL=            # postgresql://user:pass@host:5432/sentinel  (blank = SQLite in ./data)
SENTINEL_TOKEN=          # admin token; required to open the dashboard when set
